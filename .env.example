# APP_URL: The HTTPS URL where ReelCraft is hosted (Cloudflare Pages URL).
APP_URL="https://reelcraft.pages.dev"

# ADMIN_PASSWORD: Required in production to protect the hidden /admin console.
# If unset on first run, /admin provides a one-time setup form to claim an admin password.
ADMIN_PASSWORD=""

# TELEGRAM_BOT_TOKEN: Optional env fallback for your Telegram bot token (can also be set in /admin).
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_WEBHOOK_SECRET: Optional secret token verified on /api/telegram/webhook requests.
TELEGRAM_WEBHOOK_SECRET=""

# SESSION_SECRET: Optional signing secret for admin Bearer tokens (defaults to random runtime secret).
SESSION_SECRET=""
